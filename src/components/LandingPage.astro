---
import Base from '../layouts/Base.astro';
import Header from './sections/Header.astro';
import Hero from './sections/Hero.astro';
import HowItWorks from './sections/HowItWorks.astro';
import Approvals from './sections/Approvals.astro';
import Status from './sections/Status.astro';
import Groups from './sections/Groups.astro';
import LocalFirst from './sections/LocalFirst.astro';
import Requirements from './sections/Requirements.astro';
import Waitlist from './sections/Waitlist.astro';
import Footer from './sections/Footer.astro';
import { getDict } from '../i18n';
import type { Lang } from '../config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getDict(lang);
---

<Base lang={lang}>
  <Header slot="header" t={t} />
  <Hero t={t} />
  <HowItWorks t={t} />
  <Approvals t={t} />
  <Status t={t} />
  <Groups t={t} />
  <LocalFirst t={t} />
  <Requirements t={t} />
  <Waitlist t={t} />
  <Footer slot="footer" t={t} />
</Base>
