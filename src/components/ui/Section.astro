---
interface Props {
  id: string;
  title: string;
  intro?: string;
  /** `surface`: franja a todo el ancho en el tono de superficie, para el cierre de la página. */
  tone?: 'surface';
  /** `split`: desde 60rem, el encabezado a la izquierda y el contenido a la derecha. */
  layout?: 'split';
}
const { id, title, intro, tone, layout } = Astro.props;
const headingId = `${id}-title`;
---

<section {id} aria-labelledby={headingId} tabindex="-1" class:list={['section', tone, layout]}>
  <div class="container">
    <header class="head">
      <h2 id={headingId}>{title}</h2>
      {intro && <p class="intro">{intro}</p>}
      <slot name="head" />
    </header>
    <div class="body">
      <slot />
    </div>
  </div>
</section>

<style>
  .section {
    padding-block: 4rem;
    scroll-margin-top: 1rem;
  }
  .section:focus {
    outline: none;
  }
  .surface {
    background: var(--surface);
  }
  .head {
    max-width: 40rem;
    margin-bottom: 2.5rem;
  }
  h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    text-wrap: balance;
  }
  .intro {
    margin-top: 0.75rem;
    color: var(--text-secondary);
    font-size: 1.125rem;
  }
  @media (min-width: 48rem) {
    .section {
      padding-block: 6rem;
    }
  }
  @media (min-width: 60rem) {
    .split .container {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 4rem;
      align-items: end;
    }
    .split .head {
      margin-bottom: 0;
    }
  }
</style>
