---
import { getImage } from 'astro:assets';

interface Props {
  /** Nombre base de la captura, sin idioma, tema ni extensión (p. ej. `tablero`) */
  file: string;
  lang: string;
  alt: string;
  label: string;
  /** Proporción del hueco mientras no exista la captura */
  ratio?: string;
  /** `eager` solo para la captura del hero; el resto se carga en diferido. */
  loading?: 'eager' | 'lazy';
  /** Ancho que ocupa la captura en la página, para elegir el archivo adecuado. */
  sizes?: string;
}
const {
  file,
  lang,
  alt,
  label,
  ratio = '16 / 10',
  loading = 'lazy',
  sizes = '(min-width: 72rem) 70rem, 100vw',
} = Astro.props;

const shots = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/*.{png,jpg,jpeg,webp}',
  { eager: true },
);
const lightName = `${file}-${lang}-light.png`;
const darkName = `${file}-${lang}-dark.png`;
const light = shots[`/src/assets/${lightName}`]?.default;
const dark = shots[`/src/assets/${darkName}`]?.default;
const missing = [light ? '' : lightName, dark ? '' : darkName].filter(Boolean);

const widths = [480, 800, 1200];
const lightImg = light && (await getImage({ src: light, widths, format: 'webp' }));
const darkImg = dark && (await getImage({ src: dark, widths, format: 'webp' }));
---

{
  light && dark && lightImg && darkImg ? (
    <picture>
      <source
        media="(prefers-color-scheme: dark)"
        srcset={darkImg.srcSet.attribute}
        {sizes}
      />
      <img
        src={lightImg.src}
        srcset={lightImg.srcSet.attribute}
        {sizes}
        width={light.width}
        height={light.height}
        alt={alt}
        loading={loading}
        decoding="async"
        class="shot"
      />
    </picture>
  ) : (
    <div class="todo" style={`aspect-ratio: ${ratio}`} role="img" aria-label={alt}>
      <p class="mono"><strong>{label}</strong></p>
      {missing.map((name) => <p class="mono name">src/assets/{name}</p>)}
    </div>
  )
}

<style>
  .shot {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .todo {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    padding: 1rem;
    width: 100%;
    background: var(--surface);
    border: 1px dashed var(--text-secondary);
    border-radius: var(--radius);
    text-align: center;
  }
  .name {
    color: var(--text-secondary);
    overflow-wrap: anywhere;
  }
</style>
