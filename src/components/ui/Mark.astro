---
/**
 * La marca, copiada de la app (`src/components/Logo.tsx`): una U de siete puestos. Seis círculos
 * son personas y el cuadrado, en el color de acento, es el agente que completa el equipo.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class:list={['mark', className]} viewBox="0 0 24 32" aria-hidden="true" focusable="false">
  <g fill="currentColor">
    <circle cx="4" cy="4" r="3.6" />
    <circle cx="4" cy="12" r="3.6" />
    <circle cx="4" cy="20" r="3.6" />
    <circle cx="12" cy="28" r="3.6" />
    <circle cx="20" cy="12" r="3.6" />
    <circle cx="20" cy="20" r="3.6" />
  </g>
  <rect x="16.4" y="0.4" width="7.2" height="7.2" fill="var(--accent)" />
</svg>

<style>
  .mark {
    display: block;
    width: auto;
    height: 1.75rem;
  }
</style>
