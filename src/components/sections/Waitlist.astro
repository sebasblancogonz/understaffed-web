---
import { config } from '../../config';
import type { Dict } from '../../i18n/types';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const { waitlist } = t;
// Sin destino no hay envío: el formulario no lleva `action` y el botón va deshabilitado, lo que
// también impide el envío implícito con Intro.
const ready = Boolean(config.waitlistUrl);
const tags = t.hero.tags;
---

<section id={waitlist.id} class="waitlist" aria-labelledby="waitlist-title" tabindex="-1">
  <div class="wrap">
    <div class="band" data-reveal>
      <ul class="tags" aria-hidden="true">
        {tags.slice(0, 4).map((tag, i) => <li class={`tag tone-${tag.tone} s${i}`}>{tag.label}</li>)}
      </ul>
      <div class="inner">
        <h2 id="waitlist-title">{waitlist.title}</h2>
        <p class="lead">{waitlist.lead}</p>
        <form class="form" method="post" action={ready ? config.waitlistUrl : undefined}>
          <input type="hidden" name="lang" value={t.lang} />
          <label for="waitlist-email">{waitlist.label}</label>
          <div class="row">
            <input id="waitlist-email" class="field" name="email" type="email" required autocomplete="email" inputmode="email" autocapitalize="off" spellcheck="false" />
            <button class="submit" type="submit" disabled={!ready} aria-describedby={ready ? undefined : 'waitlist-todo'}>{waitlist.submit}</button>
          </div>
          <p class="after">{waitlist.after}</p>
          {!ready && <p id="waitlist-todo" class="todo">{waitlist.todo}</p>}
          <p class="todo">{waitlist.privacyTodo}</p>
        </form>
        <!-- Si el servicio redirige a #thanks, la confirmación aparece sin JavaScript. -->
        <div id="thanks" class="thanks" tabindex="-1">
          <p class="thanks-title">{waitlist.thanksTitle}</p>
          <p>{waitlist.thanks}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .waitlist {
    padding-block: 0 var(--section);
  }
  .band {
    position: relative;
    overflow: hidden;
    padding: clamp(3rem, 2rem + 5vw, 6rem) clamp(1.25rem, 0.5rem + 4vw, 4rem);
    border-radius: var(--radius-xl);
    background: var(--band);
    color: var(--on-band);
    text-align: center;
  }
  .inner {
    position: relative;
    max-width: 40rem;
    margin-inline: auto;
  }
  h2 {
    font-size: var(--step-head);
    font-weight: 850;
    letter-spacing: -0.035em;
  }
  .lead {
    margin-top: 1rem;
    color: var(--on-band-muted);
    font-size: var(--step-lead);
  }
  .form {
    margin-top: 2rem;
    text-align: left;
  }
  label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 600;
  }
  .row {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .field {
    flex: 1;
    min-width: 0;
    min-height: 3.5rem;
    padding: 0 1.125rem;
    border: 0;
    border-radius: var(--radius);
    background: var(--on-band);
    color: var(--band-ink);
    font-size: var(--step-lead);
  }
  .field:focus-visible {
    outline: 3px solid var(--on-band);
    outline-offset: 3px;
  }
  .field:user-invalid {
    outline: 3px solid var(--on-band-danger);
    outline-offset: 0;
  }
  .submit {
    min-height: 3.5rem;
    padding: 0 1.75rem;
    border: 0;
    border-radius: var(--radius);
    background: var(--band-ink);
    color: var(--on-band);
    font-size: var(--step-lead);
    font-weight: 650;
    cursor: pointer;
    transition: transform var(--t-press) var(--ease-out), background-color var(--t-hover) ease;
  }
  .submit:active:not(:disabled) {
    transform: scale(0.98);
  }
  @media (hover: hover) and (pointer: fine) {
    .submit:not(:disabled):hover {
      background: var(--band-ink-hover);
    }
  }
  .submit:focus-visible {
    outline: 3px solid var(--on-band);
    outline-offset: 3px;
  }
  .submit:disabled {
    background: rgb(13 16 23 / 0.35);
    color: var(--on-band-muted);
    cursor: not-allowed;
  }
  .after {
    margin-top: 1rem;
    color: var(--on-band);
  }
  .todo {
    margin-top: 0.375rem;
    color: var(--on-band-muted);
    font-size: var(--step-small);
  }
  .thanks {
    display: none;
    scroll-margin-top: 10rem;
  }
  .thanks:target {
    display: block;
    margin-top: 2rem;
  }
  .inner:has(.thanks:target) .form {
    display: none;
  }
  .thanks:focus {
    outline: none;
  }
  .thanks-title {
    font-size: var(--step-title);
    font-weight: 750;
  }
  /* Etiquetas de roles flotando en las esquinas de la banda. */
  .tags {
    display: none;
  }
  @media (min-width: 64rem) {
    .row {
      flex-direction: row;
    }
    .tags {
      display: block;
      position: absolute;
      inset: 0;
      pointer-events: none;
      font-size: 1.125rem;
    }
    .tags .tag {
      position: absolute;
      transform: rotate(var(--r));
    }
    .s0 { --r: -6deg; top: 12%; left: 5%; }
    .s1 { --r: 4deg; bottom: 14%; left: 8%; }
    .s2 { --r: 5deg; top: 16%; right: 6%; }
    .s3 { --r: -5deg; bottom: 12%; right: 5%; }
  }
</style>
