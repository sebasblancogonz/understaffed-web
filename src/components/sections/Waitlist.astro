---
import { config } from '../../config';
import type { Dict } from '../../i18n/types';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const { waitlist } = t;
// Sin destino no hay lista de espera: mejor un build roto que un formulario que no envía.
if (!config.waitlistUrl) throw new Error('config.waitlistUrl está vacío: la lista de espera no tiene adónde enviar.');
const tags = t.hero.tags;
const email = config.waitlistEmail;
/** Las dos mitades de un texto alrededor de `{email}`, para poner ahí el enlace al buzón. */
const around = (text: string) => text.split('{email}');
const [privacyBefore, privacyAfter = ''] = around(waitlist.privacy);
const [noJsBefore, noJsAfter = ''] = around(waitlist.noJs);
// Lo que escribe el script: el botón mientras envía, los errores y la confirmación.
const strings = {
  sending: waitlist.sending,
  errors: waitlist.errors,
  mailbox: email,
  thanksTitle: waitlist.thanksTitle,
  thanks: waitlist.thanks,
};
---

<section id={waitlist.id} class="waitlist" aria-labelledby="waitlist-title" tabindex="-1">
  <div class="wrap">
    <div class="band" data-reveal>
      <ul class="tags" aria-hidden="true">
        {tags.slice(0, 4).map((tag, i) => <li class={`tag tone-${tag.tone} s${i}`}>{tag.label}</li>)}
      </ul>
      <div class="inner" data-waitlist data-endpoint={config.waitlistUrl} data-strings={JSON.stringify(strings)}>
        <h2 id="waitlist-title" tabindex="-1" data-title>{waitlist.title}</h2>
        <p class="lead" data-lead>{waitlist.lead}</p>
        <form class="form" method="post">
          <input type="hidden" name="lang" value={t.lang} />
          <label for="waitlist-email">{waitlist.label}</label>
          <div class="row">
            <input id="waitlist-email" class="field" name="email" type="email" required autocomplete="email" inputmode="email" autocapitalize="off" spellcheck="false" aria-describedby="waitlist-error" />
            <button class="submit" type="submit">{waitlist.submit}</button>
            <p id="waitlist-error" class="error" role="alert"></p>
          </div>
          <p class="after">{waitlist.after}</p>
          <!--email_off-->
          <p class="note">{privacyBefore}<a href={`mailto:${email}`}>{email}</a>{privacyAfter}</p>
          <!--/email_off-->
        </form>
        {/* Tras apuntarse: volver al formulario para corregir la dirección o apuntar otra. */}
        <p class="again" data-again hidden>
          <button type="button" class="link">{waitlist.again}</button>
          <a class="link" href="#demo" data-try>{waitlist.backToDemo}</a>
        </p>
        {/* El envío lo hace el script. Sin él, en lugar del formulario se ve cómo apuntarse por correo. */}
        <!--email_off-->
        <p class="nojs">{noJsBefore}<a href={`mailto:${email}`}>{email}</a>{noJsAfter}</p>
        <!--/email_off-->
      </div>
    </div>
  </div>
</section>

<style>
  .waitlist {
    padding-block: 0 var(--section);
  }
  .band {
    position: relative;
    overflow: hidden;
    padding: clamp(3rem, 2rem + 5vw, 6rem) clamp(1.25rem, 0.5rem + 4vw, 4rem);
    border-radius: var(--radius-xl);
    background: var(--band);
    color: var(--on-band);
    text-align: center;
  }
  .inner {
    position: relative;
    max-width: 40rem;
    margin-inline: auto;
  }
  h2 {
    font-size: var(--step-head);
    font-weight: 750;
    letter-spacing: -0.01em;
  }
  .lead {
    margin-top: 1rem;
    color: var(--on-band-muted);
    font-size: var(--step-lead);
  }
  .form {
    margin-top: 2rem;
    text-align: left;
  }
  label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 600;
  }
  /* El error va pegado al campo: en una columna, entre el campo y el botón. */
  .row {
    display: grid;
    grid-template-areas: 'field' 'error' 'submit';
    gap: 0.625rem;
  }
  .field {
    grid-area: field;
    min-width: 0;
    min-height: 3.5rem;
    padding: 0 1.125rem;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--on-band);
    color: var(--band-ink);
    font-size: var(--step-lead);
  }
  .field:focus-visible {
    outline: 3px solid var(--on-band);
    outline-offset: 3px;
  }
  .field[aria-invalid='true'] {
    outline: 3px solid var(--on-band-danger);
    outline-offset: 0;
  }
  .field:read-only {
    color: color-mix(in srgb, var(--band-ink) 60%, var(--on-band));
  }
  .field::selection {
    background: var(--band);
    color: var(--on-band);
  }
  .submit {
    grid-area: submit;
    min-height: 3.5rem;
    padding: 0 1.75rem;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--band-ink);
    color: var(--on-band);
    font-size: var(--step-lead);
    font-weight: 650;
    cursor: pointer;
    transition: transform var(--t-press) var(--ease-out), background-color var(--t-hover) ease;
  }
  .submit:active:not([aria-disabled='true']) {
    transform: scale(0.98);
  }
  @media (hover: hover) and (pointer: fine) {
    .submit:not([aria-disabled='true']):hover {
      background: var(--band-ink-hover);
    }
  }
  .submit:focus-visible {
    outline: 3px solid var(--on-band);
    outline-offset: 3px;
  }
  /* Solo mientras se envía. Sigue enfocable, para no perder el foco. */
  .submit[aria-disabled='true'] {
    background: rgb(13 16 23 / 0.35);
    color: var(--on-band-muted);
    cursor: progress;
  }
  .error {
    grid-area: error;
    padding-inline: 0.25rem;
    color: var(--on-band-danger);
    font-weight: 600;
  }
  .error:empty {
    display: none;
  }
  .after {
    margin-top: 1rem;
    color: var(--on-band);
  }
  .note,
  .nojs {
    color: var(--on-band-muted);
  }
  .note {
    max-width: 34rem;
    margin-top: 0.375rem;
    font-size: var(--step-small);
  }
  /* La confirmación conserva el alto de la banda y se centra en él. */
  .inner[data-done] {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .again {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 1.5rem;
    margin-top: 1.5rem;
  }
  .again[hidden] {
    display: none;
  }
  .link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.5rem;
    border: 0;
    background: none;
    color: var(--on-band);
    font: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }
  .link:focus-visible {
    outline: 3px solid var(--on-band);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }
  .error :global(a) {
    color: inherit;
  }
  @media (pointer: coarse) {
    /* En un enlace en línea, el relleno agranda lo que se toca sin mover el texto. */
    .note a,
    .nojs a {
      padding-block: 0.75rem;
    }
  }
  .inner a {
    color: var(--on-band);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .inner a:focus-visible {
    outline: 3px solid var(--on-band);
    outline-offset: 3px;
  }
  /* El título, cuando recibe el foco al confirmar el alta. */
  h2:focus {
    outline: none;
  }
  .form[hidden] {
    display: none;
  }
  /* Sin el script no hay envío: en lugar del formulario, cómo apuntarse por correo. */
  .nojs {
    display: none;
    margin-top: 2rem;
  }
  :global(html:not(.js)) .form {
    display: none;
  }
  :global(html:not(.js)) .nojs {
    display: block;
  }
  /* Etiquetas de roles flotando en las esquinas de la banda. Como la banda, no cambian con el tema. */
  .tags {
    display: none;
    --lilac: #ecdcff;
    --lilac-ink: #b48af5;
    --orange: #ffe3c8;
    --orange-ink: #f6a15e;
    --green: #d3f5df;
    --green-ink: #5cc98a;
    --yellow: #fff0bf;
    --yellow-ink: #efbf3f;
    --ink: var(--band-ink);
  }
  @media (min-width: 64rem) {
    .row {
      grid-template-columns: 1fr auto;
      grid-template-areas: 'field submit' 'error error';
    }
    .tags {
      display: block;
      position: absolute;
      inset: 0;
      pointer-events: none;
      font-size: 1.125rem;
    }
    .tags .tag {
      position: absolute;
      transform: rotate(var(--r));
    }
    .s0 { --r: -6deg; top: 12%; left: 5%; }
    .s1 { --r: 4deg; bottom: 14%; left: 8%; }
    .s2 { --r: 5deg; top: 16%; right: 6%; }
    .s3 { --r: -5deg; bottom: 12%; right: 5%; }
  }
</style>
