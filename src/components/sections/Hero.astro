---
import Demo from './Demo.astro';
import type { Dict } from '../../i18n/types';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const { hero } = t;
// Posición de cada etiqueta alrededor del titular, como en el comp aprobado: tres a la izquierda y
// dos a la derecha, cada una con su giro.
const spots = ['l1', 'l2', 'l3', 'r1', 'r2'];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap">
    <div class="intro">
      <h1 id="hero-title">
        <span class="line">{hero.title[0]}</span>
        <span class="line">{hero.title[1]}</span>
      </h1>
      <p class="lead">{hero.lead}</p>
      <div class="actions">
        <a class="button large" href={`#${t.waitlist.id}`}>{hero.cta}</a>
        <a class="button large secondary" href={`#${t.how.id}`}>{hero.secondary}</a>
      </div>
      <ul class="tags" aria-hidden="true">
        {
          hero.tags.map((tag, i) => (
            <li class={`tag tone-${tag.tone} ${spots[i]}`} style={`--i:${i}`}>
              {tag.label}
            </li>
          ))
        }
      </ul>
    </div>
    <Demo t={t} />
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(0.75rem, 0.25rem + 1.2vw, 1.25rem);
    overflow: hidden;
  }
  .intro {
    position: relative;
    text-align: center;
  }
  h1 {
    font-size: var(--step-display);
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.04;
  }
  .line {
    display: block;
  }
  .lead {
    max-width: 40rem;
    margin: 1rem auto 0;
    color: var(--muted);
    font-size: var(--step-lead);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1rem;
    margin-top: 1.5rem;
  }
  /* Etiquetas de roles: en móvil, una fila bajo los botones; en escritorio, flotando alrededor. */
  .tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.75rem;
    font-size: var(--step-small);
  }
  @media (max-width: 30rem) {
    .actions .button {
      flex: 1 1 100%;
    }
  }
  @media (min-width: 72rem) {
    .tags {
      position: absolute;
      inset: 0;
      margin: 0;
      pointer-events: none;
      font-size: 1.375rem;
    }
    .tags .tag {
      position: absolute;
      padding: 0.55rem 1.2rem 0.55rem 1rem;
      transform: rotate(var(--r, 0deg));
    }
    .l1 { --r: -5deg; top: 8%; left: 5%; }
    .l2 { --r: 3deg; top: 36%; left: 1.5%; }
    .l3 { --r: -6deg; top: 62%; left: 3.5%; }
    .r1 { --r: 0deg; top: 16%; right: 5%; }
    .r2 { --r: -9deg; top: 47%; right: 1.5%; }
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hero h1,
    :global(.js) .hero .lead,
    :global(.js) .hero .actions {
      animation: rise 800ms var(--ease-out) both;
    }
    :global(.js) .hero .lead {
      animation-delay: 90ms;
    }
    :global(.js) .hero .actions {
      animation-delay: 180ms;
    }
    :global(.js) .hero .tag {
      animation: pop 700ms var(--ease-out) both;
      animation-delay: calc(350ms + var(--i) * 90ms);
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(12px) rotate(var(--r, 0deg)) scale(0.9);
    }
  }
</style>
