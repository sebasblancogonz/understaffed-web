---
import Demo from './Demo.astro';
import type { Dict } from '../../i18n/types';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
// La acción principal lleva al único formulario de la página, en la sección de cierre.
const href = `#${t.waitlist.id}`;
// El titular sube línea a línea desde su línea base (movimiento propio de la dirección).
const words = t.hero.title.split(' ');
const cut = Math.ceil(words.length / 2);
const lines = [words.slice(0, cut).join(' '), words.slice(cut).join(' ')];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="copy">
    <div class="bottom">
      <h1 id="hero-title" class="lines">
        {
          lines.map((line, i) => (
            <span class="line">
              <span data-line style={`--i:${i}`}>{line}</span>
            </span>
          ))
        }
      </h1>
      <p class="lead" data-rise style="--i:2">{t.hero.lead}</p>
      <div class="actions" data-rise style="--i:2">
        <a class="button" href={href}>{t.hero.cta}</a>
      </div>
      <p class="note" data-rise style="--i:3">{t.hero.note}</p>
    </div>
  </div>
  <div class="stage">
    <Demo t={t} />
  </div>
</section>

<style>
  .hero {
    display: grid;
  }
  .copy {
    display: flex;
    align-items: flex-end;
    padding: var(--margin);
    padding-top: 1.5rem;
  }
  .bottom {
    max-width: 34rem;
  }
  h1 {
    font-size: var(--step-lead);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.15;
  }
  .lines .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }
  .lines [data-line] {
    display: block;
  }
  .lead {
    margin-top: 1rem;
    max-width: 44ch;
    color: var(--ink);
  }
  .actions {
    margin-top: 1.75rem;
  }
  .note {
    margin-top: 1rem;
    max-width: 44ch;
    color: var(--muted);
    font-size: var(--step-small);
  }
  .stage {
    display: grid;
    place-items: center;
    order: -1;
    padding: 4.5rem 1rem 1.5rem;
    background: var(--surface);
  }

  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: 1fr 1fr;
      min-height: 100svh;
    }
    .copy {
      padding: var(--margin);
    }
    .lines .line {
      display: inline-block;
      vertical-align: top;
    }
    .lines .line + .line {
      margin-left: 0.25em;
    }
    .stage {
      order: 0;
      min-height: 100svh;
      padding: 5rem var(--margin);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .lines [data-line] {
      transform: translateY(105%);
      animation: line-up 900ms var(--ease-out) forwards;
      animation-delay: calc(var(--i) * 110ms + 150ms);
    }
    :global(.js) [data-rise] {
      opacity: 0;
      transform: translateY(18px);
      animation: rise var(--t-reveal) var(--ease-out) forwards;
      animation-delay: calc(var(--i, 0) * 90ms + 200ms);
    }
  }
  @keyframes line-up {
    to {
      transform: none;
    }
  }
  @keyframes rise {
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
