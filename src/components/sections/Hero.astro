---
import Button from '../ui/Button.astro';
import Placeholder from '../ui/Placeholder.astro';
import { config } from '../../config';
import type { Dict } from '../../i18n/types';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const href = config.downloadUrl || `#${t.how.id}`;

// Vídeo de fondo: solo en escritorio y sin movimiento reducido. Las condiciones van en el
// `media` de cada fuente para que el navegador no descargue nada si no se cumplen, y la
// variante sigue al tema del sistema, como el resto de la página.
const video = `/video/understaffed-demo-${t.lang}`;
const motion = '(min-width: 48rem) and (prefers-reduced-motion: no-preference)';
const sources = [
  { scheme: 'light', file: `${video}-light` },
  { scheme: 'dark', file: video },
];
const stills = `--still-light: url(${video}-light-poster.jpg); --still-dark: url(${video}-poster.jpg)`;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="stage">
    <div class="backdrop" aria-hidden="true" style={stills}>
      <video autoplay muted loop playsinline disablepictureinpicture tabindex="-1">
        {
          sources.flatMap(({ scheme, file }) => [
            <source src={`${file}.webm`} type="video/webm" media={`${motion} and (prefers-color-scheme: ${scheme})`} />,
            <source src={`${file}.mp4`} type="video/mp4" media={`${motion} and (prefers-color-scheme: ${scheme})`} />,
          ])
        }
      </video>
    </div>
    <div class="container">
      <div class="copy">
        <h1 id="hero-title">{t.hero.title}</h1>
        <p class="lead">{t.hero.lead}</p>
        <div class="actions">
          <Button href={href}>{t.hero.cta}</Button>
          {!config.downloadUrl && <p class="todo mono">{t.hero.ctaTodo}</p>}
        </div>
        <p class="note">{t.hero.note}</p>
      </div>
    </div>
  </div>
  <div class="container">
    <div class="visual">
      <Placeholder lang={t.lang} file={t.hero.shot.file} alt={t.hero.shot.alt} label={t.placeholder.label} />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: 0 2rem;
  }
  .stage {
    position: relative;
    isolation: isolate;
    padding-block: 3.5rem 0;
  }
  .backdrop {
    display: none;
  }
  .copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 48rem;
    margin-inline: auto;
    text-align: center;
  }
  h1 {
    font-size: clamp(2.25rem, 7vw, 4rem);
    letter-spacing: -0.035em;
  }
  .lead {
    margin-top: 1.25rem;
    color: var(--text-secondary);
    font-size: 1.1875rem;
  }
  .actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .todo {
    color: var(--text-secondary);
    font-size: 0.8125rem;
  }
  .note {
    margin-top: 1.25rem;
    color: var(--text-secondary);
    font-size: 0.9375rem;
  }
  .visual {
    margin-top: 3rem;
  }

  @media (min-width: 48rem) {
    .stage {
      padding-block: 6rem 5rem;
      overflow: hidden;
    }
    .visual {
      margin-top: 1rem;
    }
    .backdrop {
      display: block;
      position: absolute;
      inset: 0;
      z-index: -1;
      overflow: hidden;
      /* Fotograma fijo: se ve mientras carga el vídeo y en su lugar con movimiento reducido. */
      background: var(--still-light) center / cover no-repeat;
      /* Desenfoque leve: los textos del vídeo no compiten con los del hero. */
      filter: blur(2px);
    }
    video {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    /* Velo con el color de fondo: al 88 % detrás del texto (contraste AA de --text-secondary
       en el peor píxel del vídeo, en ambos temas), más ligero a los lados y opaco abajo
       para fundirse con la página antes de la captura. */
    .backdrop::after {
      content: '';
      position: absolute;
      inset: 0;
      --veil: color-mix(in srgb, var(--bg) 88%, transparent);
      --side: color-mix(in srgb, var(--bg) 55%, transparent);
      background:
        linear-gradient(to bottom, color-mix(in srgb, var(--bg) 40%, transparent), transparent 18%, transparent 62%, var(--bg)),
        linear-gradient(to right, var(--side), var(--veil) calc(50% - 26rem), var(--veil) calc(50% + 26rem), var(--side));
    }
  }
  @media (min-width: 48rem) and (prefers-color-scheme: dark) {
    .backdrop {
      background-image: var(--still-dark);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    video {
      display: none;
    }
  }
</style>
