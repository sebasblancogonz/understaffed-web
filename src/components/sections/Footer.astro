---
import type { Dict } from '../../i18n/types';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const { footer } = t;
---

<!-- Una sola línea tranquila tras un tramo de fondo vacío: qué es, los enlaces y el año. -->
<footer class="footer">
  <div class="wrap line">
    <p class="what">{footer.text}</p>
    <nav aria-label={footer.navLabel}>
      <ul>
        {
          footer.nav.map((item) => (
            <li>
              <a class="link" href={`#${item.id}`}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="year">{footer.year}</p>
  </div>
</footer>

<style>
  .footer {
    padding-top: 30svh;
    padding-bottom: 1.875rem;
    font-size: var(--step-small);
  }
  .line {
    display: grid;
    gap: 0.5rem;
  }
  .what,
  .year {
    color: var(--muted);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }
  a {
    display: inline-block;
    padding-block: 0.25rem;
    color: var(--ink);
  }
  @media (min-width: 60rem) {
    .line {
      grid-template-columns: 1fr auto 1fr;
      align-items: baseline;
      gap: 2rem;
    }
    .year {
      text-align: right;
    }
  }
</style>
