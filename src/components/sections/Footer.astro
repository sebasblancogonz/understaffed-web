---
import Mark from '../ui/Mark.astro';
import { paths, type Lang } from '../../config';
import type { Dict } from '../../i18n/types';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const { footer } = t;
const other: Lang = t.lang === 'es' ? 'en' : 'es';
---

<footer class="footer">
  <div class="wrap">
    <div class="grid">
      <div class="brand">
        <p class="logo"><Mark /><span>Understaffed</span></p>
        <p class="text">{footer.text}</p>
      </div>
      <nav aria-label={footer.productLabel}>
        <p class="label">{footer.productLabel}</p>
        <ul>
          {
            t.header.nav.map((item) => (
              <li>
                <a href={`#${item.id}`}>{item.label}</a>
              </li>
            ))
          }
          <li><a href={`#${t.waitlist.id}`}>{t.header.cta}</a></li>
        </ul>
      </nav>
      <div>
        <p class="label">{footer.languageLabel}</p>
        <ul>
          <li><a href={paths[other]} hreflang={other} lang={other}>{t.header.switchText}</a></li>
        </ul>
      </div>
    </div>
    <p class="copy">{footer.copyright}</p>
  </div>
</footer>

<style>
  .footer {
    padding-block: 4rem 2.5rem;
    border-top: 1px solid var(--border);
    font-size: var(--step-small);
  }
  .grid {
    display: grid;
    gap: 2.5rem;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.25rem;
    font-weight: 750;
    letter-spacing: -0.03em;
  }
  .text {
    max-width: 22rem;
    margin-top: 0.75rem;
    color: var(--muted);
  }
  .label {
    margin-bottom: 0.75rem;
    font-weight: 650;
  }
  ul {
    display: grid;
    gap: 0.5rem;
  }
  a {
    color: var(--muted);
    text-decoration: none;
    transition: color var(--t-hover) ease;
  }
  @media (hover: hover) and (pointer: fine) {
    a:hover {
      color: var(--ink);
    }
  }
  .copy {
    margin-top: 3rem;
    color: var(--muted);
  }
  @media (min-width: 48rem) {
    .grid {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }
</style>
