---
import type { Dict } from '../../i18n/types';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const { requirements } = t;
// Los nombres de comando van en `code` (spec: rutas y comandos en monoespaciada).
const parts = (text: string) => text.split(/(\bgit\b)/g);
---

<section id={requirements.id} class="req" aria-labelledby="requirements-title" tabindex="-1">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <h2 id="requirements-title">{requirements.title}</h2>
      <p>{parts(requirements.text).map((p) => (p === 'git' ? <code>git</code> : p))}</p>
    </header>
    <ul class="tiles">
      {
        requirements.tiles.map((tile, i) => (
          <li data-reveal style={`--i:${i}`}>
            <h3 class="name">{tile.href ? <a href={tile.href} rel="noopener">{tile.name}</a> : tile.name}</h3>
            <p class="text">{tile.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .req {
    padding-block: 0 var(--section);
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 2.5rem;
  }
  .tiles li {
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    box-shadow: var(--shadow-sm);
    text-align: center;
  }
  .name {
    font-size: var(--step-title);
    font-weight: 750;
    letter-spacing: -0.01em;
  }
  .name a {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--field-border);
    transition: text-decoration-color var(--t-hover) ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .name a:hover {
      text-decoration-color: var(--accent);
    }
  }
  .text {
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: var(--step-small);
  }
  @media (min-width: 48rem) {
    .tiles {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
