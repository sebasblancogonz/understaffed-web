---
import Shot from '../ui/Shot.astro';
import type { Dict } from '../../i18n/types';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const { how } = t;
---

<section id={how.id} class="how" aria-labelledby="how-title" tabindex="-1">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <h2 id="how-title">{how.title}</h2>
      <p>{how.lead}</p>
    </header>
    <ol class="cards">
      {
        how.cards.map((card, i) => (
          <li class={`card tone-${card.tone}`} data-reveal style={`--i:${i}`}>
            <h3>{card.title}</h3>
            <p class="text">{card.text}</p>
            <div class="media">
              {card.shot ? (
                <div class="frame">
                  <Shot lang={t.lang} file={card.shot.file} alt={card.shot.alt} label={t.placeholder.label} ratio="16 / 10" sizes="(min-width: 64rem) 24rem, 100vw" />
                </div>
              ) : card.code ? (
                <div class="frame code">
                  <p>{card.code.label}</p>
                  <pre><code>{card.code.text}</code></pre>
                </div>
              ) : null}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .how {
    padding-block: var(--section);
  }
  .cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }
  .card {
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 1rem + 1.5vw, 2rem);
    border-radius: var(--radius-lg);
    background: var(--tone-soft);
  }
  /* El color del paso va en el círculo del título, no en una etiqueta. */
  h3 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--step-title);
    font-weight: 750;
  }
  h3::before {
    content: '';
    flex: none;
    width: 0.6em;
    height: 0.6em;
    border-radius: 50%;
    background: var(--tone-ink);
  }
  .text {
    margin-top: 0.625rem;
    color: var(--muted);
  }
  .media {
    margin-top: auto;
    padding-top: 1.5rem;
  }
  .frame {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--bg);
    box-shadow: var(--shadow-sm);
  }
  /* Cada captura es un recorte de la región que prueba la afirmación, ya en la proporción del marco.
     `!important`: la regla con ámbito de Shot (`.shot img { height: auto }`) pesa más. */
  .frame :global(picture),
  .frame :global(img) {
    display: block;
    width: 100% !important;
    height: 100% !important;
  }
  .frame :global(img) {
    object-fit: cover;
    /* El recorte sigue por la derecha: se desvanece en vez de cortar una palabra. */
    mask-image: linear-gradient(to right, var(--ink) calc(100% - 2.5rem), transparent);
  }
  /* El bloque de código mide lo mismo que los recortes y crece si su contenido no cabe. */
  .frame.code {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    overflow: visible;
    padding: 1rem 1.25rem;
    font-size: var(--step-small);
  }
  .frame.code p {
    color: var(--muted);
  }
  /* El comando se parte solo en sus saltos de línea; si no cabe, se desplaza dentro del bloque. */
  pre {
    margin: 0;
    overflow-x: auto;
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  @media (min-width: 64rem) {
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
