---
import type { Dict } from '../../i18n/types';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const { roles } = t;
const d = roles.dialog;
const MAX = 8000;
// La plantilla que enseña el diálogo al cargar: Desarrollador backend.
const START = Math.max(0, roles.templates.findIndex((tpl) => tpl.tone === 'lilac'));
const first = roles.templates[START];
const fill = (text: string, name: string) => text.replace('{name}', name);
const countOf = (prompt: string) => d.count.replace('{used}', String(prompt.length)).replace('{max}', String(MAX));
// Lo que necesita el script para cambiar el diálogo de plantilla.
const strings = JSON.stringify({
  hireFrom: d.hireFrom,
  alt: d.alt,
  count: d.count,
  max: MAX,
  templates: roles.templates.map(({ name, prompt }) => ({ name, prompt })),
});
---

<section id={roles.id} class="roles" aria-labelledby="roles-title" tabindex="-1">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <h2 id="roles-title">{roles.title}</h2>
      <p>{roles.lead}</p>
    </header>
    <div class="layout">
      <div class="catalog" data-reveal>
        <p class="catalog-label">{roles.templatesLabel}</p>
        <ul class="templates">
          {
            roles.templates.map((tpl, i) => (
              <li class:list={['template', `tone-${tpl.tone}`, { current: i === START }]} data-template data-tone={tpl.tone}>
                <p class="who">
                  <span class="tag">{tpl.name}</span>
                  <span class="mark">{roles.current}</span>
                  {/* La flecha dice que la fila se pulsa. Solo se ve con el script, en las filas sin elegir. */}
                  <svg class="go" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
                    <path d="M4 10h11m-4.5-4.5L15 10l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </p>
                <p class="says">
                  <q>{tpl.text}</q>
                </p>
                {/* Ocupa toda la fila. Sin el script no aparece: la fila es solo texto. */}
                <button type="button" class="pick" data-pick aria-pressed={i === START ? 'true' : 'false'} aria-label={fill(roles.pick, tpl.name)} hidden />
              </li>
            ))
          }
        </ul>
      </div>

      <!-- El diálogo de contratar de la app, con sus textos. Sus botones están dibujados y no se usan; lo que se lee de verdad son las instrucciones, que se desplazan. La lista de al lado elige la plantilla. -->
      <figure class="dialog" data-reveal style="--i:1">
        <div class="panel window" data-ui role="group" aria-label={fill(d.alt, first.name)} data-role-dialog data-strings={strings}>
          <div class="part head">
            <p class="dialog-title" data-role-title>{fill(d.hireFrom, first.name)}</p>
          </div>
          <div class="part">
            <p class="label">{d.name}</p>
            <p class="value" data-role-name>{first.name}</p>
          </div>
          <div class="part">
            <p class="label-row">
              <span class="label">{d.prompt}</span>
              <span class="muted" data-role-count>{countOf(first.prompt)}</span>
            </p>
            <p class="value prompt" data-role-prompt tabindex="0" role="region" aria-label={d.prompt}>{first.prompt}</p>
          </div>
          <div class="part">
            <p class="label">{d.model}</p>
            <p class="value muted">{d.modelPlaceholder}</p>
          </div>
          <div class="part">
            <p class="label">{d.permissions}</p>
            <p class="switch-row">
              <span class="switch"></span>
              <span>{d.allowBash}</span>
            </p>
          </div>
          <div class="part foot" aria-hidden="true">
            <span class="ui-btn">{d.back}</span>
            <span class="ui-btn primary">{d.confirm}</span>
          </div>
        </div>
        <figcaption>{roles.caption}</figcaption>
        <p class="sr-only" aria-live="polite" data-role-live></p>
      </figure>
    </div>
  </div>
</section>

<style>
  .roles {
    padding-block: var(--section);
  }
  .layout {
    display: grid;
    gap: 1.5rem;
    align-items: start;
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }
  /* Las plantillas son una lista, no tarjetas: el nombre del rol y cómo empiezan sus instrucciones. */
  .catalog-label {
    color: var(--muted);
    font-size: var(--step-small);
    font-weight: 600;
  }
  .templates {
    margin-top: 0.75rem;
    border-top: 1px solid var(--border);
  }
  .template {
    position: relative;
    display: grid;
    gap: 0.625rem;
    padding: 1.125rem 0.25rem;
    border-bottom: 1px solid var(--border);
  }
  /* El botón de cada fila la cubre entera: se pulsa la fila, no una palabra. */
  .pick {
    position: absolute;
    inset: 0;
    width: 100%;
    border: 0;
    border-radius: var(--radius);
    background: none;
    cursor: pointer;
  }
  .pick[hidden] {
    display: none;
  }
  .pick:focus-visible {
    outline-offset: -3px;
  }
  @media (hover: hover) and (pointer: fine) {
    .template:not(.current):has(.pick:hover) .tag {
      box-shadow: inset 0 0 0 2px var(--tone-ink);
    }
  }
  .template:not(.current) .mark {
    display: none;
  }
  /* La flecha va al final de la fila, centrada en su alto. */
  .go {
    display: none;
    position: absolute;
    top: 50%;
    right: 0.25rem;
    translate: 0 -50%;
    color: var(--muted);
  }
  .template {
    padding-right: 2.25rem;
  }
  :global(.js) .template:not(.current) .go {
    display: block;
  }
  .dialog {
    scroll-margin-top: 5.5rem;
  }
  /* La plantilla que enseña el diálogo lleva el fondo suave de su color. */
  .template.current {
    z-index: 1;
    margin-inline: -0.75rem;
    padding-inline: 1rem;
    border-radius: var(--radius);
    border-bottom-color: transparent;
    background: var(--tone-soft);
  }
  .who {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }
  .template .tag {
    font-size: 1rem;
  }
  .mark {
    color: var(--muted);
    font-size: var(--step-small);
    font-weight: 500;
  }
  /* El texto es del rol, no del visitante: va entre comillas y en gris. */
  .says {
    color: var(--muted);
    font-size: var(--step-small);
  }
  .dialog figcaption {
    margin-top: 0.875rem;
    color: var(--muted);
    font-size: var(--step-small);
    text-align: center;
  }

  /* El editor: convenciones de la app (radios pequeños, bordes de 1 px). */
  [data-ui].panel {
    font-size: var(--step-small);
  }
  [data-ui] .part {
    margin: 0;
    padding: 0.75rem 1.5rem;
    border: 0;
    min-width: 0;
  }
  [data-ui] .part.head {
    padding-top: 1.5rem;
  }
  [data-ui] .dialog-title {
    font-size: 1.125rem;
    font-weight: 650;
    letter-spacing: -0.02em;
  }
  [data-ui] .muted {
    color: var(--muted);
  }
  [data-ui] .label {
    display: block;
    margin-bottom: 0.375rem;
    font-weight: 500;
  }
  [data-ui] .label-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  [data-ui] .value {
    min-height: 2.25rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--field-border);
    border-radius: 6px;
    background: var(--bg);
    line-height: 1.45;
  }
  /* Las instrucciones enseñan su arranque y se pierden hacia abajo, como en el campo de la app. */
  /* Las instrucciones se leen enteras: el campo se desplaza, como en la app. */
  [data-ui] .prompt {
    max-height: 13rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    white-space: pre-line;
    scrollbar-width: thin;
    scrollbar-color: var(--field-border) transparent;
  }
  [data-ui] .prompt:focus-visible {
    outline-offset: 2px;
  }
  [data-ui] .switch-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  [data-ui] .switch {
    flex: none;
    position: relative;
    width: 2.25rem;
    height: 1.25rem;
    border-radius: 999px;
    background: var(--field-border);
  }
  [data-ui] .switch::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: var(--bg);
  }
  /* Los botones del pie están dibujados: van apagados para que no parezcan pulsables. */
  [data-ui] .foot .ui-btn {
    opacity: 0.45;
  }
  [data-ui] .foot {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    padding-block: 1rem 1.5rem;
    border-top: 1px solid var(--border);
  }
  [data-ui] .ui-btn {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--field-border);
    border-radius: 6px;
    font-weight: 500;
  }
  [data-ui] .ui-btn.primary {
    border-color: var(--brand);
    background: var(--brand);
    color: var(--on-brand);
  }
  @media (min-width: 64rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 27rem);
      gap: 3.5rem;
    }
    .says {
      font-size: inherit;
    }
    .template {
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: 1.5rem;
      align-items: start;
    }
  }
</style>
