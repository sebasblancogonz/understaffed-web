---
import type { Dict } from '../../i18n/types';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const { roles } = t;
const d = roles.dialog;
const MAX = 8000;
const count = d.count.replace('{used}', String(d.promptValue.length)).replace('{max}', String(MAX));
---

<section id={roles.id} class="roles" aria-labelledby="roles-title" tabindex="-1">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <h2 id="roles-title">{roles.title}</h2>
      <p>{roles.lead}</p>
    </header>
    <div class="layout">
      <ul class="templates">
        {
          roles.templates.map((tpl, i) => (
            <li class={`template tone-${tpl.tone}`} data-reveal style={`--i:${i}`}>
              <span class="tag">{tpl.name}</span>
              <p>{tpl.text}</p>
            </li>
          ))
        }
      </ul>

      <!-- El editor de un rol de la app, a tamaño real y con sus textos. -->
      <div class="panel window" data-ui data-reveal style="--i:2">
        <div class="part head">
          <p class="dialog-title">{d.title}</p>
          <p class="muted">{d.hint}</p>
        </div>
        <div class="part">
          <label for="role-name">{d.name}</label>
          <input id="role-name" type="text" value={d.nameValue} autocomplete="off" />
        </div>
        <div class="part">
          <p class="label-row">
            <label for="role-prompt">{d.prompt}</label>
            <span class="muted" data-count data-template={d.count} data-max={MAX}>{count}</span>
          </p>
          <textarea id="role-prompt" rows="7" maxlength={MAX} data-prompt>{d.promptValue}</textarea>
        </div>
        <div class="part">
          <label for="role-model">{d.model}</label>
          <input id="role-model" type="text" placeholder={d.modelPlaceholder} autocomplete="off" />
          <p class="muted small">{d.modelHint}</p>
        </div>
        <fieldset class="part">
          <legend>{d.permissions}</legend>
          <div class="switch-row">
            <input id="role-bash" type="checkbox" role="switch" class="switch" />
            <div>
              <label for="role-bash">{d.allowBash}</label>
              <p class="muted small">{d.allowBashHint}</p>
            </div>
          </div>
        </fieldset>
        <div class="part">
          <p class="muted small">{d.toolsLine}</p>
        </div>
        <div class="part foot">
          <span class="ui-btn">{d.back}</span>
          <span class="ui-btn primary">{d.confirm}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .roles {
    padding-block: var(--section);
  }
  .layout {
    display: grid;
    gap: 1.5rem;
    align-items: start;
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }
  .templates {
    display: grid;
    gap: 1rem;
  }
  .template {
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    background: var(--tone-soft);
  }
  .template .tag {
    font-size: 1rem;
  }
  .template p {
    margin-top: 0.875rem;
    color: var(--ink);
  }

  /* El editor: convenciones de la app (radios pequeños, bordes de 1 px). */
  [data-ui].panel {
    font-size: var(--step-small);
  }
  [data-ui] .part {
    margin: 0;
    padding: 0.75rem 1.5rem;
    border: 0;
    min-width: 0;
  }
  [data-ui] .part.head {
    padding-top: 1.5rem;
  }
  [data-ui] .dialog-title {
    font-size: 1.125rem;
    font-weight: 650;
    letter-spacing: -0.02em;
  }
  [data-ui] .muted {
    color: var(--muted);
  }
  [data-ui] .small {
    margin-top: 0.375rem;
  }
  [data-ui] label,
  [data-ui] legend {
    display: block;
    margin-bottom: 0.375rem;
    padding: 0;
    font-weight: 500;
  }
  [data-ui] .label-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  [data-ui] input[type='text'],
  [data-ui] textarea {
    display: block;
    width: 100%;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--field-border);
    border-radius: 6px;
    background: var(--bg);
    font-size: var(--step-small);
    line-height: 1.45;
  }
  [data-ui] input[type='text'] {
    height: 2.25rem;
  }
  [data-ui] input::placeholder {
    color: var(--muted);
  }
  [data-ui] textarea {
    resize: vertical;
  }
  [data-ui] .switch-row {
    display: flex;
    gap: 0.75rem;
  }
  [data-ui] .switch-row label {
    margin-bottom: 0;
  }
  [data-ui] .switch {
    flex: none;
    position: relative;
    width: 2.25rem;
    height: 1.25rem;
    margin: 0.125rem 0 0;
    border-radius: 999px;
    background: var(--field-border);
    appearance: none;
    cursor: pointer;
    transition: background-color var(--t-hover) ease;
  }
  [data-ui] .switch::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: var(--bg);
    transition: transform 240ms var(--ease-out);
  }
  [data-ui] .switch:checked {
    background: var(--brand);
  }
  [data-ui] .switch:checked::after {
    transform: translateX(1rem);
  }
  [data-ui] .foot {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    padding-block: 1rem 1.5rem;
    border-top: 1px solid var(--border);
  }
  [data-ui] .ui-btn {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--field-border);
    border-radius: 6px;
    font-weight: 500;
  }
  [data-ui] .ui-btn.primary {
    border-color: var(--brand);
    background: var(--brand);
    color: var(--on-brand);
  }
  @media (min-width: 64rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 27rem);
      gap: 2rem;
    }
    .templates {
      gap: 1.25rem;
    }
    .template {
      padding: 1.75rem 2rem;
    }
  }
</style>
