---
import type { Dict } from '../../i18n/types';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const { roles } = t;
const d = roles.dialog;
const MAX = 8000;
const count = d.count.replace('{used}', String(d.promptValue.length)).replace('{max}', String(MAX));
---

<section id={roles.id} class="roles" aria-labelledby="roles-title" tabindex="-1">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <h2 id="roles-title">{roles.title}</h2>
      <p>{roles.lead}</p>
    </header>
    <div class="layout">
      <ul class="templates">
        {
          roles.templates.map((tpl, i) => (
            <li class={`template tone-${tpl.tone}`} data-reveal style={`--i:${i}`}>
              <span class="tag">{tpl.name}</span>
              <p>{tpl.text}</p>
            </li>
          ))
        }
      </ul>

      <!-- El diálogo de contratar de la app, con sus textos. Es una imagen: no tiene controles. -->
      <div class="panel window" data-ui data-reveal style="--i:2" role="img" aria-label={d.alt}>
        <div class="part head">
          <p class="dialog-title">{d.title}</p>
        </div>
        <div class="part">
          <p class="label">{d.name}</p>
          <p class="value">{d.nameValue}</p>
        </div>
        <div class="part">
          <p class="label-row">
            <span class="label">{d.prompt}</span>
            <span class="muted">{count}</span>
          </p>
          <p class="value prompt">{d.promptValue}</p>
        </div>
        <div class="part">
          <p class="label">{d.model}</p>
          <p class="value muted">{d.modelPlaceholder}</p>
        </div>
        <div class="part">
          <p class="label">{d.permissions}</p>
          <p class="switch-row">
            <span class="switch"></span>
            <span>{d.allowBash}</span>
          </p>
        </div>
        <div class="part foot">
          <span class="ui-btn">{d.back}</span>
          <span class="ui-btn primary">{d.confirm}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .roles {
    padding-block: var(--section);
  }
  .layout {
    display: grid;
    gap: 1.5rem;
    align-items: start;
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }
  .templates {
    display: grid;
    gap: 1rem;
  }
  .template {
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    background: var(--tone-soft);
  }
  .template .tag {
    font-size: 1rem;
  }
  .template p {
    margin-top: 0.875rem;
    color: var(--ink);
  }

  /* El editor: convenciones de la app (radios pequeños, bordes de 1 px). */
  [data-ui].panel {
    font-size: var(--step-small);
  }
  [data-ui] .part {
    margin: 0;
    padding: 0.75rem 1.5rem;
    border: 0;
    min-width: 0;
  }
  [data-ui] .part.head {
    padding-top: 1.5rem;
  }
  [data-ui] .dialog-title {
    font-size: 1.125rem;
    font-weight: 650;
    letter-spacing: -0.02em;
  }
  [data-ui] .muted {
    color: var(--muted);
  }
  [data-ui] .label {
    display: block;
    margin-bottom: 0.375rem;
    font-weight: 500;
  }
  [data-ui] .label-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  [data-ui] .value {
    min-height: 2.25rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--field-border);
    border-radius: 6px;
    background: var(--bg);
    line-height: 1.45;
  }
  /* Las instrucciones enseñan su arranque y se pierden hacia abajo, como en el campo de la app. */
  [data-ui] .prompt {
    max-height: 9.5rem;
    overflow: hidden;
    white-space: pre-line;
    mask-image: linear-gradient(var(--ink) 60%, transparent);
  }
  [data-ui] .switch-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  [data-ui] .switch {
    flex: none;
    position: relative;
    width: 2.25rem;
    height: 1.25rem;
    border-radius: 999px;
    background: var(--field-border);
  }
  [data-ui] .switch::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: var(--bg);
  }
  [data-ui] .foot {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    padding-block: 1rem 1.5rem;
    border-top: 1px solid var(--border);
  }
  [data-ui] .ui-btn {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--field-border);
    border-radius: 6px;
    font-weight: 500;
  }
  [data-ui] .ui-btn.primary {
    border-color: var(--brand);
    background: var(--brand);
    color: var(--on-brand);
  }
  @media (min-width: 64rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 27rem);
      gap: 2rem;
    }
    .templates {
      gap: 1.25rem;
    }
    .template {
      padding: 1.75rem 2rem;
    }
  }
</style>
