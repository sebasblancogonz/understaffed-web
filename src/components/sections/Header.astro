---
import Mark from '../ui/Mark.astro';
import { paths, type Lang } from '../../config';
import type { Dict } from '../../i18n/types';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const other: Lang = t.lang === 'es' ? 'en' : 'es';
---

<header class="header">
  <div class="bar">
    <a class="brand" href={paths[t.lang]} aria-label={t.header.home}>
      <Mark />
      <span class="word">Understaffed</span>
    </a>
    <nav class="nav" aria-label={t.header.navLabel}>
      <ul>
        {
          t.header.nav.map((item) => (
            <li>
              <a href={`#${item.id}`}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="end">
      <a class="lang" href={paths[other]} hreflang={other} lang={other}>
        {t.header.switchText}
      </a>
      <a class="button cta" href={`#${t.waitlist.id}`}>{t.header.cta}</a>
      <!-- Por debajo de 64rem, las secciones y el idioma van en este menú. -->
      <details class="menu" data-menu>
        <summary aria-label={t.header.menu}>
          <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
            <path d="M3 6h14M3 10h14M3 14h14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
          </svg>
        </summary>
        <nav class="sheet" aria-label={t.header.menu}>
          <ul>
            {
              t.header.nav.map((item) => (
                <li>
                  <a href={`#${item.id}`}>{item.label}</a>
                </li>
              ))
            }
            <li class="rule">
              <a href={paths[other]} hreflang={other} lang={other}>{t.header.switchText}</a>
            </li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  /* Fija arriba: las secciones y «Pedir acceso» acompañan toda la página. */
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }
  /* A todo el ancho de la ventana, con el margen lateral de la página. */
  .bar {
    position: relative;
    padding-inline: var(--margin);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.5rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    --mark: 2rem;
    color: var(--ink);
    text-decoration: none;
  }
  .word {
    font-size: 1.4rem;
    font-weight: 750;
    letter-spacing: -0.03em;
  }
  .nav {
    display: none;
  }
  .nav ul {
    display: flex;
    gap: 2.25rem;
  }
  .nav a,
  .lang {
    color: var(--muted);
    font-size: var(--step-body);
    font-weight: 500;
    text-decoration: none;
    transition: color var(--t-hover) ease;
  }
  .nav a[aria-current] {
    color: var(--ink);
  }
  @media (hover: hover) and (pointer: fine) {
    .nav a:hover,
    .lang:hover {
      color: var(--ink);
    }
  }
  .end {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .cta {
    min-height: 2.75rem;
    padding: 0.5rem 1.125rem;
    font-size: 1rem;
  }
  /* En pantallas estrechas el idioma va dentro del menú. */
  .lang {
    display: none;
  }
  .menu summary {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-pill);
    box-shadow: inset 0 0 0 1.5px var(--field-border);
    color: var(--ink);
    cursor: pointer;
    list-style: none;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu[open] summary {
    background: var(--surface);
  }
  .sheet {
    position: absolute;
    top: calc(100% - 0.25rem);
    right: var(--margin);
    min-width: 15rem;
    padding: 0.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    box-shadow: var(--shadow-lg);
  }
  .sheet ul {
    display: block;
  }
  .sheet a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.875rem;
    border-radius: var(--radius-sm);
    color: var(--ink);
    font-weight: 500;
    text-decoration: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .sheet a:hover {
      background: var(--surface);
    }
  }
  .sheet .rule {
    margin-top: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border);
  }
  .sheet .rule a {
    color: var(--muted);
  }
  @media (max-width: 30rem) {
    .word {
      font-size: 1.125rem;
    }
    .brand {
      --mark: 1.5rem;
      gap: 0.4rem;
    }
    .cta {
      padding-inline: 0.875rem;
      font-size: var(--step-small);
    }
    .end {
      gap: 0.75rem;
    }
  }
  @media (min-width: 64rem) {
    .bar {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
    }
    .nav {
      display: block;
    }
    .lang {
      display: inline;
    }
    .menu {
      display: none;
    }
    .end {
      justify-self: end;
      gap: 1.75rem;
    }
  }
</style>
