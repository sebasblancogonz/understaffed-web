---
import Mark from '../ui/Mark.astro';
import { paths, type Lang } from '../../config';
import type { Dict } from '../../i18n/types';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const other: Lang = t.lang === 'es' ? 'en' : 'es';
---

<header class="header">
  <div class="bar">
    <a class="brand" href={paths[t.lang]} aria-label={t.header.home}>
      <Mark />
      <span class="word">Understaffed</span>
    </a>
    <nav class="nav" aria-label={t.header.navLabel}>
      <ul>
        {
          t.header.nav.map((item) => (
            <li>
              <a href={`#${item.id}`}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="end">
      <a class="lang" href={paths[other]} hreflang={other} lang={other} aria-label={t.header.switchLabel}>
        <span class="full">{t.header.switchText}</span><span class="short" aria-hidden="true">{t.header.switchShort}</span>
      </a>
      <a class="button cta" href={`#${t.waitlist.id}`}>{t.header.cta}</a>
    </div>
  </div>
</header>

<style>
  /* A todo el ancho de la ventana, con el margen lateral de la página. */
  .bar {
    padding-inline: var(--margin);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.5rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    --mark: 2rem;
    color: var(--ink);
    text-decoration: none;
  }
  .word {
    font-size: 1.4rem;
    font-weight: 750;
    letter-spacing: -0.03em;
  }
  .nav {
    display: none;
  }
  .nav ul {
    display: flex;
    gap: 2.25rem;
  }
  .nav a,
  .lang {
    color: var(--muted);
    font-size: var(--step-body);
    font-weight: 500;
    text-decoration: none;
    transition: color var(--t-hover) ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .nav a:hover,
    .lang:hover {
      color: var(--ink);
    }
  }
  .end {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .cta {
    min-height: 2.75rem;
    padding: 0.5rem 1.125rem;
    font-size: 1rem;
  }
  .short {
    display: none;
  }
  @media (max-width: 24rem) {
    .full {
      display: none;
    }
    .short {
      display: inline;
    }
  }
  @media (max-width: 30rem) {
    .word {
      font-size: 1.125rem;
    }
    .brand {
      --mark: 1.5rem;
      gap: 0.4rem;
    }
    .lang {
      font-size: var(--step-small);
    }
    .cta {
      padding-inline: 0.875rem;
      font-size: var(--step-small);
    }
    .end {
      gap: 0.75rem;
    }
  }
  @media (min-width: 64rem) {
    .bar {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
    }
    .nav {
      display: block;
    }
    .end {
      justify-self: end;
      gap: 1.75rem;
    }
  }
</style>
