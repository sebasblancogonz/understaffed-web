---
import Mark from '../ui/Mark.astro';
import { paths, type Lang } from '../../config';
import type { Dict } from '../../i18n/types';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const other: Lang = t.lang === 'es' ? 'en' : 'es';
---

<!-- Sin barra de navegación: la marca arriba a la izquierda y el cambio de idioma a la derecha.
     Los enlaces a las secciones están en el pie. -->
<header class="header">
  <a class="brand" href={paths[t.lang]} aria-label={t.header.home}>
    <Mark />
    <span class="word">Understaffed</span>
  </a>
  <a class="lang link" href={paths[other]} hreflang={other} lang={other} aria-label={t.header.switchLabel}>
    {t.header.switchText}
  </a>
</header>

<style>
  .header {
    position: absolute;
    inset: 0 0 auto;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--margin);
    pointer-events: none;
  }
  .header a {
    pointer-events: auto;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--ink);
    text-decoration: none;
  }
  .word {
    font-size: var(--step-body);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .lang {
    padding-block: 0.5rem;
    font-size: var(--step-small);
    font-weight: 500;
  }
</style>
