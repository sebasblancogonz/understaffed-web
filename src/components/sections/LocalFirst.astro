---
import Shot from '../ui/Shot.astro';
import type { Dict } from '../../i18n/types';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const { local } = t;

---

<section id={local.id} class="local" aria-labelledby="local-title" tabindex="-1">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <h2 id="local-title">{local.title}</h2>
      <p>{local.lead}</p>
    </header>
    <ul class="cards">
      {
        local.cards.map((card, i) => (
          <li class={`card tone-${card.tone}`} data-reveal style={`--i:${i}`}>
            <p class="top">
              <span class="tag">{card.title}</span>
              <span class="sub">{card.sub}</span>
            </p>
            <ul class="points">
              {card.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
            <div class="frame">
              <Shot lang={t.lang} file={card.media.shot.file} alt={card.media.shot.alt} label={t.placeholder.label} ratio="4 / 3" sizes="(min-width: 64rem) 24rem, 100vw" />
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .local {
    padding-block: var(--section);
  }
  .cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }
  .card {
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 1rem + 1.5vw, 2rem);
    border-radius: var(--radius-lg);
    background: var(--tone-soft);
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }
  .tag {
    font-size: var(--step-title);
  }
  .sub {
    color: var(--muted);
    font-weight: 500;
  }
  .points {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }
  .points li {
    display: flex;
    gap: 0.625rem;
  }
  .points li::before {
    content: '';
    flex: none;
    width: 0.6em;
    height: 0.6em;
    margin-top: 0.5em;
    background: var(--tone-ink);
  }
  .frame {
    margin-top: auto;
    padding-top: 1.75rem;
  }
  .frame > :global(*) {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--bg);
    box-shadow: var(--shadow-sm);
  }
  .frame :global(picture),
  .frame :global(img) {
    width: 100%;
    height: 100%;
  }
  .frame :global(img) {
    object-fit: cover;
    object-position: left top;
  }
  @media (min-width: 64rem) {
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
