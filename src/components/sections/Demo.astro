---
import type { Card, Dict } from '../../i18n/types';

/**
 * Fragmento del tablero de la app, recortado, con la tarea de demostración #4. Solo avanza cuando el
 * visitante pulsa las acciones reales («Aprobar spec», «Ejecutar», «Aprobar»). Sin JavaScript se ve la
 * tarjeta esperando aprobación y los pasos escritos. Dentro de `data-ui` rigen las convenciones de la
 * app (radios pequeños, bordes de 1 px, chips en píldora).
 */
interface Props {
  t: Dict;
}
const { t } = Astro.props;
const d = t.hero.demo;

// Recuento inicial por columna: la tarea de demostración empieza en Backlog.
const counts = d.others.map((cards, i) => cards.length + (i === 0 ? 1 : 0));

// Textos que necesita el script, en un atributo para no escribir cadenas en el código de cliente.
const strings = JSON.stringify({
  columns: d.columns,
  chips: d.chips,
  hints: d.hints,
  notes: d.notes,
  log: d.log,
  done: d.done,
  live: d.live,
  title: d.task.title,
  total: d.task.total,
});

const chipFor = (state: Card['state']) =>
  state === 'awaiting' ? d.chips.awaiting : state === 'running' ? d.chips.running : state === 'awaitingReview' ? d.chips.awaitingReview : '';
---

<div class="demo" data-ui data-demo data-step="0" data-strings={strings} role="group" aria-label={d.label} tabindex="-1">
  <div class="viewport">
    <ol class="track" data-track>
      {
        d.columns.map((col, i) => (
          <li class="col" data-col={i}>
            <p class="col-head">
              <span>{col}</span> <span class="count" data-count>{counts[i]}</span>
            </p>
            <ul class="cards" data-cards>
              {i === 0 && (
                <li class="card task awaiting" data-task>
                  <p class="state" data-state>
                    <span class="chip">{d.chips.awaiting}</span>
                  </p>
                  <p class="title">{d.task.title}</p>
                  <p class="meta">
                    <span class="num">{d.task.num}</span>
                    <span class="prio">{d.task.prio}</span>
                    <span data-progress>0/{d.task.total}</span>
                    <span class="role">
                      {d.task.role}
                      <span class="agent"></span>
                    </span>
                  </p>
                </li>
              )}
              {d.others[i].map((card) => (
                <li class:list={['card', { awaiting: card.state === 'awaiting' }]}>
                  {card.state && (
                    <p class="state">
                      {card.state === 'running' ? (
                        <span class="running">
                          <span class="spin"></span>
                          {chipFor(card.state)}
                        </span>
                      ) : (
                        <span class="chip">{chipFor(card.state)}</span>
                      )}
                    </p>
                  )}
                  <p class="title">{card.title}</p>
                  <p class="meta">
                    <span class="num">{card.num}</span>
                    <span class="prio">{card.prio}</span>
                    {card.progress && <span>{card.progress}</span>}
                    {card.role && (
                      <span class="role">
                        {card.role}
                        <span class="agent"></span>
                      </span>
                    )}
                  </p>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="panel">
    <ol class="log" data-log hidden></ol>
    <div class="result" data-result hidden>
      <p class="result-line"><span>{d.review.files}</span><span>{d.review.result}</span></p>
      <p class="message"><span class="agent"></span><span>{d.review.message}</span></p>
    </div>
    <p class="hint" data-hint>{d.hints[0]}</p>
    <div class="actions" data-actions>
      <button type="button" class="btn" data-act="request">{d.actions.requestChanges}</button>
      <button type="button" class="btn primary" data-act="approve">{d.actions.approveSpec}</button>
      <button type="button" class="btn primary" data-act="run" hidden>{d.actions.run}</button>
      <button type="button" class="btn" data-act="sendback" hidden>{d.actions.sendBack}</button>
      <button type="button" class="btn primary" data-act="approvecode" hidden>{d.actions.approveCode}</button>
      <button type="button" class="btn" data-act="restart" hidden>{d.actions.restart}</button>
    </div>
    <div class="fallback">
      <p>{d.fallbackTitle}</p>
      <ol>
        {d.fallback.map((step) => <li>{step}</li>)}
      </ol>
    </div>
  </div>
  <p class="caption">{d.caption}</p>
  <p class="sr-only" aria-live="polite" data-live></p>
</div>

<style>
  [data-ui].demo {
    --ui-bg: #ffffff;
    --ui-col: #f2f4f6;
    --ui-chip: #eff2f5;
    --ui-border: #e3e6eb;
    --ui-input: #d8dce3;
    --ui-ink: #0d1017;
    --ui-muted: #5b6474;
    --ui-brand: #2f5bea;
    --ui-on-brand: #ffffff;
    position: relative;
    width: min(100%, 34rem);
    background: var(--ui-bg);
    border: 1px solid var(--ui-border);
    border-radius: 12px;
    color: var(--ui-ink);
    font-size: 0.875rem;
    line-height: 1.35;
    overflow: hidden;
  }
  @media (prefers-color-scheme: dark) {
    [data-ui].demo {
      --ui-bg: #0d1017;
      --ui-col: #181c25;
      --ui-chip: #2b3342;
      --ui-border: #262d39;
      --ui-input: #303847;
      --ui-ink: #eceef2;
      --ui-muted: #9aa3b2;
      --ui-brand: #5b7fff;
      --ui-on-brand: #0d1017;
    }
  }
  [data-ui].demo:focus {
    outline: none;
  }
  [data-ui] .viewport {
    height: 10.5rem;
    padding: 0.75rem 0 0.75rem 0.75rem;
    overflow: hidden;
  }
  @media (min-width: 60rem) {
    [data-ui] .viewport {
      height: 28rem;
    }
    [data-ui] .panel {
      min-height: 15rem;
    }
  }
  [data-ui] .track {
    display: flex;
    gap: 0.5rem;
    width: max-content;
    transition: transform 650ms var(--ease-in-out);
  }
  [data-ui] .col {
    width: 15rem;
    min-height: 19rem;
    padding: 0.5rem;
    background: var(--ui-col);
    border-radius: 12px;
  }
  [data-ui] .col-head {
    padding: 0.25rem 0.375rem 0.625rem;
    font-weight: 600;
  }
  [data-ui] .count {
    margin-left: 0.25rem;
    color: var(--ui-muted);
    font-weight: 400;
  }
  [data-ui] .cards {
    display: grid;
    gap: 0.5rem;
  }
  [data-ui] .card {
    padding: 0.75rem 0.625rem 0.625rem;
    background: var(--ui-bg);
    border: 1px solid var(--ui-border);
    border-radius: 10px;
  }
  [data-ui] .card.awaiting {
    border-color: var(--ui-brand);
  }
  [data-ui] .state {
    margin-bottom: 0.5rem;
  }
  [data-ui] .chip {
    display: inline-block;
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    background: var(--ui-brand);
    color: var(--ui-on-brand);
    font-size: 0.8125rem;
    font-weight: 500;
  }
  [data-ui] .running {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
  }
  [data-ui] .spin {
    width: 0.75rem;
    height: 0.75rem;
    border: 2px solid var(--ui-input);
    border-top-color: var(--ui-ink);
    border-radius: 50%;
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-ui] .spin {
      animation: spin 900ms linear infinite;
    }
  }
  @keyframes spin {
    to {
      transform: rotate(1turn);
    }
  }
  [data-ui] .title {
    font-weight: 600;
    text-wrap: pretty;
  }
  [data-ui] .meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    color: var(--ui-muted);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }
  [data-ui] .prio {
    padding: 0.0625rem 0.5rem;
    border-radius: 999px;
    background: var(--ui-chip);
    color: var(--ui-ink);
    font-weight: 500;
  }
  [data-ui] .role {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-left: auto;
  }
  [data-ui] .agent {
    display: inline-block;
    flex: none;
    width: 0.75rem;
    height: 0.75rem;
    background: var(--ui-brand);
  }
  [data-ui] .task.arrive {
    animation: arrive 520ms var(--ease-out);
  }
  @keyframes arrive {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.98);
    }
  }
  [data-ui] .panel {
    display: grid;
    align-content: start;
    min-height: 8.75rem;
    gap: 0.75rem;
    padding: 0.875rem 0.875rem 0.75rem;
    border-top: 1px solid var(--ui-border);
  }
  [data-ui] .log {
    display: grid;
    gap: 0.25rem;
    color: var(--ui-muted);
    font-size: 0.8125rem;
  }
  [data-ui] .log[hidden],
  [data-ui] .result[hidden] {
    display: none;
  }
  [data-ui] .log li {
    animation: arrive 360ms var(--ease-out);
  }
  [data-ui] .log li:last-child {
    color: var(--ui-ink);
  }
  [data-ui] .result-line {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  [data-ui] .message {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: 0.375rem;
    color: var(--ui-muted);
  }
  [data-ui] .hint {
    color: var(--ui-muted);
    font-size: 0.8125rem;
    min-height: 2.2em;
  }
  /* Móvil: el panel compacto para que el titular y «Pedir acceso» quepan en el primer pantallazo.
     Solo la última línea del log; mientras corre o está en revisión, la pista de la columna solo
     aparece si trae la nota de una acción. */
  @media (max-width: 59.99rem) {
    [data-ui] .panel {
      align-content: end;
    }
    [data-ui][data-step='2'] .hint:not(.has-note),
    [data-ui][data-step='3'] .hint:not(.has-note) {
      display: none;
    }
    [data-ui] .log li:not(:last-child) {
      display: none;
    }
  }
  [data-ui] .actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
  }
  [data-ui] .btn {
    min-height: 2.25rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--ui-input);
    border-radius: 6px;
    background: var(--ui-bg);
    color: var(--ui-ink);
    font-weight: 500;
    cursor: pointer;
    transition: transform var(--t-press) var(--ease-out), background-color var(--t-hover) ease;
  }
  [data-ui] .btn:active {
    transform: scale(0.97);
  }
  [data-ui] .btn.primary {
    border-color: var(--ui-brand);
    background: var(--ui-brand);
    color: var(--ui-on-brand);
  }
  @media (hover: hover) and (pointer: fine) {
    [data-ui] .btn:not(.primary):hover {
      background: var(--ui-col);
    }
    [data-ui] .btn.primary:hover {
      background: color-mix(in srgb, var(--ui-brand) 88%, var(--ui-ink));
    }
  }
  [data-ui] .btn[hidden] {
    display: none;
  }
  [data-ui] .fallback {
    display: grid;
    gap: 0.375rem;
    font-size: 0.8125rem;
  }
  [data-ui] .fallback ol {
    display: grid;
    gap: 0.25rem;
    padding-left: 1.25rem;
    list-style: decimal;
    color: var(--ui-muted);
  }
  /* Sin JavaScript no hay botones que no hagan nada: se ven los pasos escritos. */
  :global(html:not(.js)) [data-ui] .actions {
    display: none;
  }
  :global(.js) [data-ui] .fallback {
    display: none;
  }
  [data-ui] .caption {
    padding: 0.625rem 0.875rem;
    background: var(--ui-col);
    color: var(--ui-muted);
    font-size: 0.8125rem;
  }
</style>
