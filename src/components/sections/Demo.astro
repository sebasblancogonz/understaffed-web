---
import Mark from '../ui/Mark.astro';
import type { Card, Dict } from '../../i18n/types';

/**
 * Ventana de la app con el tablero completo y la tarea de demostración #6, que lleva sus acciones en
 * la propia tarjeta y solo avanza cuando el visitante las pulsa. Sin JavaScript se ve la tarjeta
 * esperando aprobación y los pasos escritos. Dentro de `data-ui` rigen las convenciones de la app.
 */
interface Props {
  t: Dict;
}
const { t } = Astro.props;
const d = t.hero.demo;
const a = d.app;

const counts = d.others.map((cards, i) => cards.length + (i === 0 ? 1 : 0));
const strings = JSON.stringify({
  columns: d.columns,
  chips: d.chips,
  hints: d.hints,
  notes: d.notes,
  log: d.log,
  done: d.done,
  live: d.live,
  title: d.task.title,
  total: d.task.total,
});
const chipFor = (state: Card['state']) =>
  state === 'awaiting' ? d.chips.awaiting : state === 'running' ? d.chips.running : state === 'awaitingReview' ? d.chips.awaitingReview : '';
---

<div class="demo-wrap" id="demo">
  {/* Qué toca hacer en cada paso. Va sobre la ventana para que se lea antes que el tablero. */}
  <p class="hint" data-hint>{d.hints[0]}</p>
  <div class="window demo" data-ui data-demo data-step="0" data-strings={strings} role="group" aria-label={d.label} tabindex="-1">
    <aside class="side" aria-hidden="true">
      <p class="side-brand"><Mark class="side-mark" /><span>Understaffed</span></p>
      <p class="side-head"><span>{a.projects}</span><span class="plus">+</span></p>
      <p class="side-item">{a.project}</p>
      <div class="side-foot">
        <p class="muted">{a.noAccount}<br />{a.signIn}</p>
        <p class="side-btns"><span>{a.send}</span><span>{a.receive}</span></p>
        <p class="settings">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm7.4-3a7.4 7.4 0 0 0-.1-1.3l2-1.6-2-3.4-2.4 1a7.5 7.5 0 0 0-2.2-1.3L14.4 3h-4l-.4 2.5a7.5 7.5 0 0 0-2.2 1.3l-2.4-1-2 3.4 2 1.6a7.4 7.4 0 0 0 0 2.6l-2 1.6 2 3.4 2.4-1a7.5 7.5 0 0 0 2.2 1.3l.4 2.5h4l.4-2.5a7.5 7.5 0 0 0 2.2-1.3l2.4 1 2-3.4-2-1.6c.1-.4.1-.9.1-1.3Z"></path></svg>
          {a.settings}
        </p>
      </div>
    </aside>
    <div class="main">
      <div class="top" aria-hidden="true">
        <p class="proj">{a.project}</p>
        <p class="tabs">{a.tabs.map((tab, i) => <span class:list={{ on: i === 0 }}>{tab}</span>)}</p>
        <span class="more">···</span>
      </div>
      <p class="checks" aria-hidden="true">
        <span class="path">{a.path}</span>
        {['Git', 'OpenSpec'].map((name) => (
          <span class="ok"><svg viewBox="0 0 16 16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="m3.5 8.5 3 3 6-7"></path></svg>{name}</span>
        ))}
      </p>
      <div class="viewport">
        <ol class="track" data-track>
          {
            d.columns.map((col, i) => (
              <li class="col" data-col={i}>
                <p class="col-head">
                  <span>{col}</span> <span class="count" data-count>{counts[i]}</span>
                </p>
                <ul class="cards" data-cards>
                  {i === 0 && (
                    <li class="card task awaiting" data-task>
                      <p class="state" data-state>
                        <span class="chip">{d.chips.awaiting}</span>
                      </p>
                      <p class="title">{d.task.title}</p>
                      <p class="meta">
                        <span class="num">{d.task.num}</span>
                        <span class="prio">{d.task.prio}</span>
                        <span data-progress>0/{d.task.total}</span>
                        <span class="role">
                          {d.task.role}
                          <span class="agent" />
                        </span>
                      </p>
                      {/* Las acciones van justo bajo la tarea, siempre a la vista; debajo, lo que se decide. */}
                      <div class="actions" data-actions>
                        <button type="button" class="btn primary" data-act="approve">{d.actions.approveSpec}</button>
                        <button type="button" class="btn" data-act="request">{d.actions.requestChanges}</button>
                        <button type="button" class="btn primary" data-act="run" hidden>{d.actions.run}</button>
                        <button type="button" class="btn primary" data-act="approvecode" hidden>{d.actions.approveCode}</button>
                        <button type="button" class="btn" data-act="sendback" hidden>{d.actions.sendBack}</button>
                        <button type="button" class="btn" data-act="restart" hidden>{d.actions.restart}</button>
                      </div>
                      <p class="logline" data-log hidden />
                      {/* Lo que se aprueba: los criterios de la spec, y después los archivos que cambió el rol. */}
                      <div class="detail" data-spec>
                        <p class="detail-head">{d.spec.head} <span class="count">{d.spec.criteria.length}</span></p>
                        <ul class="criteria">
                          {d.spec.criteria.map((c) => <li>{c}</li>)}
                        </ul>
                        <p class="valid">
                          <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="m3.5 8.5 3 3 6-7" /></svg>
                          {d.spec.valid}
                        </p>
                      </div>
                      <div class="detail" data-result hidden>
                        <p class="detail-head">{d.code.head} <span class="count">{d.code.files.length}</span></p>
                        <ul class="files">
                          {d.code.files.map((f) => (
                            <li>
                              <code>{f.name}</code>
                              <span class="lines-add">+{f.add}</span>
                              {f.del && <span class="lines-del">−{f.del}</span>}
                            </li>
                          ))}
                        </ul>
                        <p class="said">{d.code.message}</p>
                      </div>
                      <p class="note" data-note hidden />
                    </li>
                  )}
                  {d.others[i].map((card) => (
                    <li class:list={['card', { awaiting: card.state === 'awaiting' }]}>
                      {card.state && (
                        <p class="state">
                          {card.state === 'running' ? (
                            <span class="running">
                              <span class="spin" />
                              {chipFor(card.state)}
                            </span>
                          ) : (
                            <span class="chip">{chipFor(card.state)}</span>
                          )}
                        </p>
                      )}
                      <p class="title">{card.title}</p>
                      <p class="meta">
                        <span class="num">{card.num}</span>
                        <span class="prio">{card.prio}</span>
                        {card.progress && <span>{card.progress}</span>}
                        {card.role && (
                          <span class="role">
                            {card.role}
                            <span class="agent" />
                          </span>
                        )}
                      </p>
                    </li>
                  ))}
                </ul>
                {i === 0 && <p class="add">+ {a.addTask}</p>}
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
  <div class="below">
    <p class="next" data-next hidden><a class="button" href={`#${t.waitlist.id}`}>{t.hero.cta}</a></p>
    <p class="caption">{d.caption}</p>
    <div class="fallback">
      <p>{d.fallbackTitle}</p>
      <ol>
        {d.fallback.map((step) => <li>{step}</li>)}
      </ol>
    </div>
  </div>
  <p class="sr-only" aria-live="polite" data-live></p>
</div>

<style>
  /* La ventana se apoya sobre una franja pastel de lado a lado que empieza a media altura de ella.
     El hero recorta lo que sobresale (`overflow: hidden`), así que no hay desplazamiento lateral. */
  .demo-wrap {
    position: relative;
    isolation: isolate;
    /* Aire entre los botones del hero y la ventana. */
    margin-top: clamp(1.75rem, 1rem + 1.5vw, 2.25rem);
    scroll-margin-top: 5.5rem;
    padding-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }
  .demo-wrap::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: clamp(5rem, 3rem + 8vw, 12rem);
    bottom: 0;
    left: calc(50% - 50vw);
    right: calc(50% - 50vw);
    background: var(--stage);
  }
  [data-ui].demo {
    --ui-bg: #ffffff;
    --ui-side: #f1f4f6;
    --ui-col: #f2f4f6;
    --ui-chip: #eff2f5;
    --ui-border: #e3e6eb;
    --ui-input: #d8dce3;
    --ui-add: #1a7f4b;
    --ui-ink: #0d1017;
    --ui-muted: #5b6474;
    --ui-active: #e2e5eb;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    color: var(--ui-ink);
    font-size: 0.875rem;
    line-height: 1.35;
    text-align: left;
  }
  @media (prefers-color-scheme: dark) {
    [data-ui].demo {
      --ui-bg: #0d1017;
      --ui-side: #15181f;
      --ui-col: #181c25;
      --ui-chip: #2b3342;
      --ui-border: #262d39;
      --ui-input: #303847;
      --ui-add: #7fdca3;
      --ui-ink: #eceef2;
      --ui-muted: #9aa3b2;
      --ui-active: #1f2530;
    }
  }
  [data-ui].demo:focus {
    outline: none;
  }
  /* Barra lateral de la app (solo en pantallas anchas). */
  [data-ui] .side {
    display: none;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 0.75rem;
    background: var(--ui-side);
  }
  [data-ui] .side-brand {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
    padding-inline: 0.25rem;
    font-size: 0.875rem;
    font-weight: 650;
    letter-spacing: -0.02em;
  }
  [data-ui] .side-brand :global(.side-mark) {
    height: 1.25rem;
  }
  [data-ui] .side-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.25rem 0.375rem;
    font-weight: 500;
  }
  [data-ui] .plus {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border: 1px solid var(--ui-border);
    border-radius: 6px;
    background: var(--ui-bg);
  }
  [data-ui] .side-item {
    padding: 0.4rem 0.5rem;
    border-radius: 8px;
    background: var(--ui-active);
  }
  [data-ui] .side-foot {
    display: grid;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 2rem;
    font-size: 0.8125rem;
  }
  [data-ui] .muted {
    color: var(--ui-muted);
  }
  [data-ui] .side-btns {
    display: flex;
    gap: 0.25rem;
  }
  [data-ui] .side-btns span {
    flex: 1;
    padding: 0.3rem;
    border: 1px solid var(--ui-border);
    border-radius: 6px;
    color: var(--ui-muted);
    text-align: center;
  }
  [data-ui] .settings {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  [data-ui] .settings svg {
    width: 1rem;
    height: 1rem;
  }
  [data-ui] .main {
    min-width: 0;
    padding: 0.875rem 0 0 0.875rem;
  }
  [data-ui] .top {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-right: 0.875rem;
  }
  [data-ui] .proj {
    font-size: 1.25rem;
    font-weight: 650;
    letter-spacing: -0.02em;
  }
  [data-ui] .tabs {
    display: flex;
    gap: 0.25rem;
    color: var(--ui-muted);
  }
  [data-ui] .tabs span {
    padding: 0.25rem 0.6rem;
    border-radius: 8px;
  }
  [data-ui] .tabs .on {
    background: var(--ui-active);
    color: var(--ui-ink);
  }
  [data-ui] .more {
    margin-left: auto;
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--ui-border);
    border-radius: 6px;
    letter-spacing: 0.1em;
  }
  [data-ui] .checks {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.5rem 0 0.75rem;
    font-size: 0.8125rem;
  }
  [data-ui] .path {
    color: var(--ui-muted);
    font-family: var(--font-mono);
  }
  [data-ui] .ok {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: var(--ui-chip);
  }
  [data-ui] .ok svg {
    width: 0.8rem;
    height: 0.8rem;
    color: var(--brand);
  }
  [data-ui] .viewport {
    height: 27rem;
    overflow: hidden;
  }
  [data-ui] .track {
    display: flex;
    gap: 0.5rem;
    width: max-content;
    padding-right: 0.875rem;
    transition: transform 650ms var(--ease-in-out);
  }
  [data-ui] .col {
    flex: 0 0 15rem;
    min-height: 30rem;
    padding: 0.4rem;
    border-radius: 12px;
    background: var(--ui-col);
  }
  [data-ui] .col-head {
    padding: 0.25rem 0.375rem 0.625rem;
    font-weight: 600;
  }
  [data-ui] .count {
    margin-left: 0.25rem;
    color: var(--ui-muted);
    font-weight: 400;
  }
  [data-ui] .cards {
    display: grid;
    gap: 0.5rem;
  }
  [data-ui] .card {
    padding: 0.55rem 0.55rem 0.5rem;
    border: 1px solid var(--ui-border);
    border-radius: 10px;
    background: var(--ui-bg);
  }
  [data-ui] .card.awaiting {
    border-color: var(--brand);
  }
  [data-ui] .task {
    box-shadow: 0 8px 24px -8px color-mix(in srgb, var(--brand) 35%, transparent);
  }
  /* La tarea que pide una decisión lleva un aro: es lo que hay que pulsar. */
  [data-ui] .task.awaiting {
    box-shadow:
      0 0 0 1px var(--brand),
      0 8px 24px -8px color-mix(in srgb, var(--brand) 35%, transparent);
  }
  [data-ui] .state {
    margin-bottom: 0.45rem;
  }
  [data-ui] .chip {
    display: inline-block;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    background: var(--brand);
    color: var(--on-brand);
    font-size: 0.75rem;
    font-weight: 600;
  }
  [data-ui] .running {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
  }
  [data-ui] .spin {
    width: 0.7rem;
    height: 0.7rem;
    border: 2px solid var(--ui-input);
    border-top-color: var(--ui-ink);
    border-radius: 50%;
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-ui] .spin {
      animation: spin 900ms linear infinite;
    }
  }
  @keyframes spin {
    to {
      transform: rotate(1turn);
    }
  }
  [data-ui] .title {
    font-size: 0.8125rem;
    font-weight: 600;
    text-wrap: pretty;
  }
  [data-ui] .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.45rem;
    color: var(--ui-muted);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }
  [data-ui] .prio {
    padding: 0.05rem 0.5rem;
    border-radius: 999px;
    background: var(--ui-chip);
    color: var(--ui-ink);
    font-weight: 500;
  }
  [data-ui] .role {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-left: auto;
    white-space: nowrap;
  }
  [data-ui] .agent {
    display: inline-block;
    flex: none;
    width: 0.7rem;
    height: 0.7rem;
    background: var(--brand);
  }
  [data-ui] .logline {
    margin-top: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--ui-border);
    color: var(--ui-muted);
    font-size: 0.75rem;
  }
  [data-ui] .logline[hidden],
  [data-ui] .detail[hidden],
  [data-ui] .note[hidden] {
    display: none;
  }
  /* Lo que el visitante aprueba, dentro de la tarjeta: criterios de la spec o archivos cambiados. */
  [data-ui] .detail {
    margin-top: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--ui-border);
    font-size: 0.75rem;
  }
  [data-ui] .detail-head {
    color: var(--ui-muted);
    font-weight: 500;
  }
  [data-ui] .detail-head .count {
    margin-left: 0.2rem;
  }
  [data-ui] .task {
    min-width: 0;
  }
  [data-ui] .criteria,
  [data-ui] .files {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.2rem;
    margin-top: 0.3rem;
  }
  [data-ui] .criteria li {
    padding: 0.3rem 0.5rem;
    border: 1px solid var(--ui-border);
    border-radius: 6px;
    font-weight: 600;
  }
  [data-ui] .valid,
  [data-ui] .said {
    margin-top: 0.4rem;
    color: var(--ui-muted);
  }
  [data-ui] .valid {
    display: flex;
    gap: 0.3rem;
  }
  [data-ui] .valid svg {
    flex: none;
    width: 0.8rem;
    height: 0.8rem;
    margin-top: 0.1rem;
    color: var(--brand);
  }
  [data-ui] .files li {
    display: flex;
    gap: 0.35rem;
    font-variant-numeric: tabular-nums;
  }
  [data-ui] .files code {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    font-size: inherit;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  [data-ui] .lines-add {
    color: var(--ui-add);
  }
  [data-ui] .lines-del {
    color: var(--danger);
  }
  /* El comentario que acompaña a «Pedir cambios» o «Devolver»: su consecuencia, en la tarjeta. */
  [data-ui] .note {
    margin-top: 0.5rem;
    padding: 0.4rem 0.5rem;
    border-radius: 6px;
    background: var(--ui-chip);
    font-size: 0.75rem;
  }
  [data-ui] .actions {
    display: grid;
    gap: 0.35rem;
    margin-top: 0.6rem;
  }
  [data-ui] .actions:empty,
  [data-ui] .actions.idle {
    display: none;
  }
  [data-ui] .btn {
    min-height: 1.875rem;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--ui-input);
    border-radius: 6px;
    background: var(--ui-bg);
    color: var(--ui-ink);
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    transition: transform var(--t-press) var(--ease-out), background-color var(--t-hover) ease;
  }
  /* Con el dedo, las acciones de la tarea tienen la altura de un botón táctil. */
  @media (pointer: coarse) {
    [data-ui] .btn {
      min-height: 2.75rem;
    }
  }
  [data-ui] .btn:active {
    transform: scale(0.97);
  }
  [data-ui] .btn.primary {
    border-color: var(--brand);
    background: var(--brand);
    color: var(--on-brand);
  }
  @media (hover: hover) and (pointer: fine) {
    [data-ui] .btn:not(.primary):hover {
      background: var(--ui-col);
    }
    [data-ui] .btn.primary:hover {
      background: color-mix(in srgb, var(--brand) 86%, var(--ui-ink));
    }
  }
  [data-ui] .btn[hidden] {
    display: none;
  }
  [data-ui] .task.arrive {
    animation: arrive 520ms var(--ease-out);
  }
  @keyframes arrive {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.98);
    }
  }
  [data-ui] .add {
    padding: 0.6rem 0.4rem;
    color: var(--ui-muted);
    font-size: 0.8125rem;
  }
  /* Sin JavaScript no hay botones que no hagan nada: se ven los pasos escritos debajo. */
  :global(html:not(.js)) [data-ui] .actions {
    display: none;
  }

  .below {
    max-width: 44rem;
    margin: 1rem auto 0;
    text-align: center;
  }
  /* Sin el script no hay acciones que pulsar: los pasos escritos hacen de pista. */
  :global(html:not(.js)) .hint {
    display: none;
  }
  .hint {
    max-width: 40rem;
    margin: 0 auto 1rem;
    color: var(--ink);
    font-weight: 600;
    text-align: center;
    text-wrap: balance;
  }
  .next {
    margin-block: 0.25rem 1rem;
  }
  .next[hidden] {
    display: none;
  }
  .caption {
    max-width: 36rem;
    margin-inline: auto;
    color: var(--muted);
    font-size: var(--step-small);
  }
  .fallback {
    display: grid;
    gap: 0.25rem;
    margin-top: 0.75rem;
    font-size: var(--step-small);
  }
  .fallback ol {
    padding-left: 1.25rem;
    list-style: decimal;
    text-align: left;
    color: var(--muted);
  }
  :global(.js) .fallback {
    display: none;
  }

  @media (min-width: 60rem) {
    [data-ui].demo {
      grid-template-columns: 9.5rem minmax(0, 1fr);
    }
    [data-ui] .side {
      display: flex;
    }
    [data-ui] .main {
      padding: 1rem 0 0 1.25rem;
    }
    [data-ui] .viewport {
      height: 28rem;
    }
  }
  /* Con anchura de sobra, las cinco columnas a la vista; si no, la cámara sigue a la tarea. */
  @media (min-width: 72rem) {
    [data-ui] .track {
      width: 100%;
      padding-right: 1.25rem;
    }
