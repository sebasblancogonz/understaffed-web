---
import Shot from '../ui/Shot.astro';
import type { Dict } from '../../i18n/types';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const { status } = t;
// Cada pie lleva un círculo de color: el cobalto para lo que espera tu decisión.
const marks = ['var(--accent)', 'var(--orange-ink)', 'var(--green-ink)'];
// La proporción de cada recorte, para su hueco mientras falte.
const ratios: Record<string, string> = { 'estado-decision': '1220 / 844', 'estado-en-marcha': '1190 / 84', 'estado-coste': '1159 / 186' };
---

<section id={status.id} class="status" aria-labelledby="status-title" tabindex="-1">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <h2 id="status-title">{status.title}</h2>
      <p>{status.lead}</p>
    </header>
    <!-- Tres recortes de la vista Estado a un tamaño que se lee: la lista y, a su lado, las dos franjas. -->
    <div class="shots">
      {
        status.shots.map((shot, i) => (
          <figure class:list={[shot.strip ? 'is-strip' : 'is-list']} data-reveal style={`--i:${i}; --mark:${marks[i]}`}>
            <div class:list={['window', 'frame', { strip: shot.strip }]}>
              <Shot
                lang={t.lang}
                file={shot.file}
                alt={shot.alt}
                label={t.placeholder.label}
                ratio={ratios[shot.file]}
                sizes={shot.strip ? '(min-width: 64rem) 30rem, 42rem' : '(min-width: 64rem) 44rem, (min-width: 40rem) 100vw, 34rem'}
              />
            </div>
            <figcaption>
              <span class="cap-title">{shot.title}</span>
              <span>{shot.caption}</span>
              {shot.file === 'estado-coste' && <span class="cost">{status.cost}</span>}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .status {
    padding-block: var(--section);
    background: var(--surface);
  }
  .shots {
    display: grid;
    gap: 2.5rem 2rem;
    align-items: start;
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }
  figure {
    min-width: 0;
  }
  /*
   * En una pantalla estrecha el recorte no se encoge hasta dejar de leerse: conserva un ancho
   * mínimo y su marco se desplaza de lado.
   */
  .frame {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }
  .frame :global(.shot) {
    min-width: 34rem;
  }
  .frame.strip :global(.shot) {
    min-width: 42rem;
  }
  .frame:focus-visible {
    outline-offset: 3px;
  }
  figcaption {
    display: grid;
    gap: 0.25rem;
    margin-top: 1.125rem;
    color: var(--muted);
  }
  .cap-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink);
    font-size: var(--step-title);
    font-family: var(--font-display);
    font-weight: 750;
    letter-spacing: -0.02em;
  }
  .cap-title::before {
    content: '';
    flex: none;
    width: 0.6em;
    height: 0.6em;
    border-radius: 50%;
    background: var(--mark);
  }
  .cost {
    margin-top: 0.25rem;
    font-size: var(--step-small);
  }
  /* La franja del coste por rol: un recorte de la barra de la app, con el radio de un panel. */
  .strip {
    border-radius: var(--radius);
  }
  @media (min-width: 40rem) {
    .frame:not(.strip) :global(.shot) {
      min-width: 0;
    }
  }
  /* La lista a la izquierda, a toda la altura; las dos franjas, una sobre otra, a su derecha. */
  @media (min-width: 64rem) {
    .shots {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
      grid-template-rows: auto 1fr;
    }
    .is-list {
      grid-row: span 2;
    }
    .frame.strip :global(.shot) {
      min-width: 0;
    }
  }
</style>
