---
import Shot from '../ui/Shot.astro';
import type { Dict } from '../../i18n/types';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const { status } = t;
// Cada pie lleva el cuadrado del agente en un color: el cobalto para lo que espera tu decisión.
const marks = ['var(--accent)', 'var(--green-ink)'];
---

<section id={status.id} class="status" aria-labelledby="status-title" tabindex="-1">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <h2 id="status-title">{status.title}</h2>
      <p>{status.lead}</p>
    </header>
    <div class="shots">
      {
        status.shots.map((shot, i) => (
          <figure data-reveal style={`--i:${i}; --mark:${marks[i]}`}>
            {shot.strip ? (
              <div class="window strip">
                <Shot lang={t.lang} file={shot.file} alt={shot.alt} label={t.placeholder.label} ratio="1159 / 186" sizes="(min-width: 64rem) 32rem, 100vw" />
              </div>
            ) : (
              <div class="window">
                <Shot lang={t.lang} file={shot.file} alt={shot.alt} label={t.placeholder.label} sizes="(min-width: 64rem) 48rem, 100vw" />
              </div>
            )}
            <figcaption>
              <span class="cap-title">{shot.title}</span>
              <span>{shot.caption}</span>
              {i === status.shots.length - 1 && <span class="cost">{status.cost}</span>}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .status {
    padding-block: var(--section);
    background: var(--surface);
  }
  .shots {
    display: grid;
    gap: 2rem;
    align-items: center;
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }
  figcaption {
    display: grid;
    gap: 0.25rem;
    margin-top: 1.125rem;
    color: var(--muted);
  }
  .cap-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink);
    font-size: var(--step-title);
    font-weight: 750;
    letter-spacing: -0.02em;
  }
  .cap-title::before {
    content: '';
    flex: none;
    width: 0.7em;
    height: 0.7em;
    background: var(--mark);
  }
  .cost {
    margin-top: 0.25rem;
    font-size: var(--step-small);
  }
  /* La franja del coste por rol: un recorte de la barra de la app, con el radio de un panel. */
  .strip {
    border-radius: var(--radius);
  }
  @media (min-width: 64rem) {
    .shots {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    }
  }
</style>
